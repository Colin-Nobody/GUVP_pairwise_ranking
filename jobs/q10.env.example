# Copy this file to jobs/q10.env on the HPC, then update values from the Q10
# probe report. Q10 is confirmed by the user; the resource values below are
# provisional starting values copied from the old Q5 job, not verified Q10 limits.
Q10_PARTITION=Q10
Q10_GRES=gpu:1
Q10_CPUS=8
Q10_MEM=32G
Q10_TIME=1-00:00:00
Q10_ACCOUNT=

# The HPC user guide documents `module load anaconda`; verify the module name
# with `jobs/probe_q10.sh`. Set HPC_MODULE=none if the environment is initialized
# in another way. `guvp-vlm` must already exist on the HPC.
HPC_MODULE=anaconda
CONDA_ENV_NAME=guvp-vlm
PYTHON_BIN=
